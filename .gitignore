# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Environments and secrets
.venv/
venv/
.env
.env.*
!.env.example

# Model artifacts (downloaded weights, large binaries)
# PORTRAITKIT_MODEL_DIR defaults to ./models; downloaded weights never enter history.
# Root-anchored: a bare "models/" would also swallow src/portraitkit/models/.
/models/
*.onnx
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.tflite
*.zip

# .NET build output. Never commit these: the ONNX Runtime native libraries alone are
# ~170 MB across six target platforms, which would dwarf the entire source tree.
[Bb]in/
[Oo]bj/

# Pipeline and benchmark output
# Note: results/ is deliberately NOT ignored; leaderboard runs are versioned in-repo.
/output/
/checkpoints/
/wandb/

# Data cache
/data/
*.jsonl
!configs/*.jsonl

# Licensed third-party standards. These are purchased single-user documents and must
# never enter a public repository. Keep them outside the project entirely; these rules
# are a second line of defence, not the primary one.
standards/
*.pdf

# Private and local-only material
# Binding: no private image, crop, embedding, or per-identity record may enter this
# repository or its history. Keep any such working material under private/ or .local/.
private/
.local/

# OS and editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
