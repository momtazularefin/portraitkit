# PortraitKit local configuration.
# Copy to .env for local use. Never commit .env.

# Model cache directory for downloaded detector/matting weights
PORTRAITKIT_MODEL_DIR=./models

# Dataset root for public evaluation datasets (P3M-10k, AM-2k, AIM-500)
PORTRAITKIT_DATA_DIR=./data

# Output directory for pipeline results and benchmark reports
PORTRAITKIT_OUTPUT_DIR=./output
